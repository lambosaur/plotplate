root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break; do not trim them.
trim_trailing_whitespace = false
# List continuation lines conventionally hang-indent 2 spaces under the marker.
# That is not 4, and it matches mdformat's own output.
# Verified: without this override, editorconfig-checker flags every such line,
# since it would otherwise inherit indent_size 4 from the [*] default above.
indent_size = 2

[Makefile]
indent_style = tab
