# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.tox/
.mypy_cache/
.ruff_cache/

# Environments
.pixi/
.venv/
.env

# direnv: .envrc is personal, .envrc.shared is the tracked template
.envrc

# Editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# This file also acts as project-meta's own .gitignore for everything under
# template/ (git applies a nested .gitignore to its own subtree, regardless
# of that subtree's role as Copier template source). Without these two
# lines, project-meta's own git silently refuses to track this directory's
# *.jinja source files, since the exceptions above only match the rendered,
# suffix-stripped names. Verified directly: settings.json.jinja was never
# tracked at all until this line was added, invisible to every commit and
# every generation this whole time. No effect on generated output; no
# .jinja-suffixed file exists there after rendering.
!.vscode/settings.json.jinja
!.vscode/extensions.json.jinja
.idea/

# Jupyter / Jupytext
.ipynb_checkpoints/

# Project-specific data/output (adjust paths to your storage layout)
data/
# Demo and example builds; panel outputs inside the packaged demo.
.demo/
src/pyplot_templated_optim/demo/**/data/
src/pyplot_templated_optim/demo/**/panels/
results/
resources/
logs/

# Machine-specific config (see docs/snakemake-conventions.md); keep the .EXAMPLE tracked
config/config.filepaths.*.yaml
!config/config.filepaths.*.EXAMPLE.yaml

# Scratch area for agents, and personal Claude Code settings
.claude/scratch/
.claude/settings.local.json
